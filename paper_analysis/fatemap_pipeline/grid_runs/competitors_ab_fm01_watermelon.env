# derived 2026-09-30 from run_competitors_ab_fm01_watermelon.sh (original archived in _archive/paper_analysis/fatemap_pipeline/superseded_grid_launchers/)
# SBATCH resources of the original (pass to sbatch; the generic header cannot vary these): -A b1042 -p genomics --cpus-per-task=8 --mem 48GB -t 12:00:00 --job-name=comp_ab_fmwm --array=0-35
MODE=array
SCRIPT=run_competitors_fatemap.py
DATASETS=(FM01 Watermelon_naive Watermelon_lag Watermelon_late)
GENE_SETS=(variability_high variability_mid variability_low detection_high detection_mid detection_low correlation_high correlation_mid correlation_low)
ARGS=(@DATASET@ --gene-set @GENE_SET@ --absplit --methods rho,ppcor,pidc,genie3,grnboost2 --n-cores 8)
