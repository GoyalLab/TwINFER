# derived 2026-09-30 from run_infer_fatemap_all.sh (original archived in _archive/paper_analysis/fatemap_pipeline/superseded_grid_launchers/)
# SBATCH resources of the original (pass to sbatch; the generic header cannot vary these): -A b1042 -p genomics --cpus-per-task=8 --mem 32GB -t 12:00:00 --job-name=fatemap_infer --array=0-17
MODE=array
SCRIPT=run_infer_fatemap.py
DATASETS=(FM06 FM08)
GENE_SETS=(variability_high variability_mid variability_low detection_high detection_mid detection_low correlation_high correlation_mid correlation_low)
ARGS=(@DATASET@ --gene-set @GENE_SET@ --n-shuffles 2000 --n-cores 8)
