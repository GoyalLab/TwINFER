# derived 2026-09-30 from run_infer_hs054_all.sh (original archived in _archive/paper_analysis/fatemap_pipeline/superseded_grid_launchers/)
# SBATCH resources of the original (pass to sbatch; the generic header cannot vary these): -A b1042 -p genomics --cpus-per-task=8 --mem 64GB -t 12:00:00 --job-name=hs054_infer
MODE=loop
SCRIPT=run_infer_hs054.py
GENE_SETS=(variability_high variability_mid variability_low detection_high detection_mid detection_low correlation_high correlation_mid correlation_low)
ARGS=(--gene-set @GENE_SET@ --n-shuffles 2000 --n-cores 8)
