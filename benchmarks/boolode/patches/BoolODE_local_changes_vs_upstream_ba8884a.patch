diff --git a/BoolODE/simulator.py b/BoolODE/simulator.py
index e993881..e537f3f 100644
--- a/BoolODE/simulator.py
+++ b/BoolODE/simulator.py
@@ -140,5 +140,12 @@ def getInitialCondition(ss, ModelSpec, rnaIndex,
         pss = ((ModelSpec['pars']['r_' + genename])/\
                                       (ModelSpec['pars']['l_p_' + genename]))\
                                       *new_ics[revvarmapper['x_' + genename]]
-        new_ics[revvarmapper['p_' + genename.replace('_','')]] = pss
+        # NOTE: was `genename.replace('_','')` -- stripped underscores from
+        # the *lookup* key here but nowhere else in this loop (the 'x_' and
+        # 'r_'/'l_p_' lookups two lines up correctly use the raw genename),
+        # so any gene name containing an underscore (e.g. names sanitized
+        # from something like 'LEF1-bCat' -> 'LEF1_bCat') produced a
+        # mismatched key and a KeyError here. Use the same genename as
+        # everywhere else in the loop.
+        new_ics[revvarmapper['p_' + genename]] = pss
     return(new_ics)
