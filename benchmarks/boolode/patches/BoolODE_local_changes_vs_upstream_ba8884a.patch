@@ -35,9 +35,10 @@ class GenerateModel:
     :param interactionStrengthDF: User specified interaction strengths. Specified in config YAML as a path
     :type interactionStrengthDF: pandas DataFrame
     """
-    def __init__(self, settings, parameterInputsDF, parameterSetDF, interactionStrengthDF) -> None:
+    def __init__(self, settings, parameterInputsDF, parameterSetDF, interactionStrengthDF,
+                 speciesTypeDF=None) -> None:
         """
-        This class is initialized with the job_settings dictionary created 
+        This class is initialized with the job_settings dictionary created
         by the BoolODE class. Additionally, three dataframe objects are required:
 
         1. parameterInputsDF - specifies parameter inputs
@@ -45,6 +46,13 @@ class GenerateModel:
         3. interactionStrengthDF - specifies interactions strengths
 
         By default, if these aren't specified by the user, BoolODE stores empty pandas DataFrame objects.
+
+        :param speciesTypeDF: optional Node/Type dataframe marking each node as
+            'gene' or 'protein' (see readBooleanRules()). Previously loaded by
+            run_experiment.startRun() but never actually passed in here, so
+            every node silently defaulted to 'gene' regardless of what a
+            species_type file said -- fixed to actually thread this through.
+        :type speciesTypeDF: pandas DataFrame
         """
         self.settings = settings
         self.parameterInputsDF = parameterInputsDF
@@ -62,7 +70,7 @@ class GenerateModel:
         self.inputs = list()
         self.genelist = list()
         self.proteinlist = list()
-        self.nodeTypeDF = pd.DataFrame()
+        self.nodeTypeDF = speciesTypeDF if speciesTypeDF is not None else pd.DataFrame()
         self.df = pd.DataFrame()
         self.ModelSpec = dict()
         self.path_to_ode_model = str()
@@ -110,8 +118,14 @@ class GenerateModel:
         self.withoutRules = list(self.allnodes.difference(set(self.withRules)))
 
         ## Every node without a rule is treated as follows:
-        ## If the user has specified a Parameter Input file treat as parameter, else 
-        for n in self.withoutRules:
+        ## If the user has specified a Parameter Input file treat as parameter, else
+        # NOTE: iterate over a copy -- the loop body calls
+        # self.withoutRules.remove(n), and mutating a list while iterating
+        # over it directly skips elements (every removal shifts later items
+        # down one position, but the loop's index keeps advancing normally).
+        # With 2+ nodes needing this fallback, at least one would silently
+        # get no rule at all, causing a NameError later when it's referenced.
+        for n in list(self.withoutRules):
             if not self.parameterInputsDF.empty\
                and n in self.parameterInputsDF['Input'] :
                 print("Treating %s as parameter" % {n})                
@@ -244,7 +258,15 @@ class GenerateModel:
         ## create the y_max parameter
         if len(self.proteinlist) > 0:
             self.par['y_max'] = y_max
-            self.par['signalingtimescale'] = signalingtimescale
+            # NOTE: was a bare undefined name (NameError) -- this branch is
+            # only reached when a node is marked 'protein' via species_type,
+            # which was previously always silently ignored (speciesTypeDF
+            # was loaded from disk but never actually passed into
+            # GenerateModel -- fixed separately), so this line had never
+            # actually executed in practice until now. signalingTimescale
+            # is loaded into kineticParameterDefaults the same way every
+            # other kinetic default is (see utils.loadParameterValues()).
+            self.par['signalingtimescale'] = self.kineticParameterDefaults['signalingTimescale']
             
         interactionStrengths = {}
     
