# Settings for run_beeline.sh -- derived 2026-09-30 from run_networksweep_genie3_grnboost2_t1_10.sh (kept in _archive/benchmarks/beeline/superseded_launchers/)
DESC="networksweep_genie3_grnboost2_t1_10: GENIE3 + GRNBOOST2 for every network_sweep_final (broader OFAT sweep) t1=10 dataset, ONE"
MODE=single
CONFIG=config-files/config_network_sweep_final_t1_10_genie3_grnboost2.yaml
REVERSE=0
SKIP_POPULATED=1
REDIRECT_NAME=genie3_grnboost2
LOG_DIR_REL=analysis_data/network_sweep_final/beeline_inference_t1_10/logs
MODULES="R/4.2.3 ruby/3.1.0-gcc-4.8.5"
SBATCH_HINT="-A b1042 -p genomics -N 1 --cpus-per-task=16 --mem 64GB -t 4:00:00"
