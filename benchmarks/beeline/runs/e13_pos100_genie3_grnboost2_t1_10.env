# Settings for run_beeline.sh -- derived 2026-09-30 from run_e13_pos100_genie3_grnboost2_t1_10.sh (kept in _archive/benchmarks/beeline/superseded_launchers/)
DESC="e13_pos100_genie3_grnboost2_t1_10: GENIE3 + GRNBOOST2 for the 3 e13_pos100 t1=10 datasets, single BLRunner.py process"
MODE=single
CONFIG=config-files/config_e13_pos100_t1_10_genie3_grnboost2.yaml
REVERSE=0
