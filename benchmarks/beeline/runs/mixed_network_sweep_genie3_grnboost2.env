# Settings for run_beeline.sh -- derived 2026-09-30 from run_mixed_network_sweep_genie3_grnboost2.sh (kept in _archive/benchmarks/beeline/superseded_launchers/)
DESC="mixed_network_sweep_genie3_grnboost2: GENIE3 + GRNBOOST2 for every mixed_network_sweep dataset, ONE BLRunner.py"
MODE=single
CONFIG=config-files/config_mixed_network_sweep_genie3_grnboost2.yaml
REVERSE=0
SKIP_POPULATED=1
REDIRECT_NAME=genie3_grnboost2
LOG_DIR_REL=analysis_data/mixed_network_sweep/beeline_inference/logs
MODULES="R/4.2.3 ruby/3.1.0-gcc-4.8.5"
SBATCH_HINT="-A b1042 -p genomics -N 1 --cpus-per-task=16 --mem 64GB -t 6:00:00"
