# Settings for run_beeline.sh -- derived 2026-09-30 from run_e13_pos100_benchmark.sh (kept in _archive/benchmarks/beeline/superseded_launchers/)
DESC="e13_pos100_benchmark: BEELINE benchmark for the e13_pos100 datasets (3 of the network_sweep_final"
MODE=single
CONFIG=config-files/config_e13_pos100.yaml
CONFIG_ABS=1  # the original passed an absolute path (SCRIPT_DIR/CONFIG)
REVERSE=0
SKIP_POPULATED=1
REDIRECT_NAME=benchmark
LOG_DIR_REL=analysis_data/network_sweep_final/e13_pos100/beeline_inference/logs
MODULES="julia/1.10.2 R/4.2.3 ruby/3.1.0-gcc-4.8.5"
SBATCH_HINT="-A b1042 -p genomics -N 1 --cpus-per-task=16 --mem 32GB -t 2:00:00"
