+        if skip_populated and (working_dir.parent / 'rankedEdges.csv').exists():
+            continue
+        params = algo.get('params', {})
+        runners.append(build_runner(algo['algorithm_id'], algo['image'], params, dataset, input_settings, output_settings))
+    return runners
