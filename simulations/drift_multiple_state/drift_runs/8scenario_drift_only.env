# derived 2026-09-30 from run_8scenario_drift_only.sh | SBATCH of the original: --array=0-1 --cpus-per-task=16 --mem=100GB --time=1:00:00 --job-name=8scen_drift_only
# Only the 4 new drift_lowmid scenarios (12 rep-tasks each); the others were already scored.
MODE=array
SCRIPT=run_6scenario_zscores.py
BASE="${TWINFER_PROJECT_ROOT}/analysis_data/drift_inference/eight_scenario"
TASK_EXPORTS=("DRIFT_T1=10 DRIFT_T2=20" "DRIFT_T1=1 DRIFT_T2=20")
TASK_OUT=("$BASE/t1_10_t2_20" "$BASE/t1_1_t2_20")
MKDIRS=("$BASE/logs" "@OUT@")
ARGS=(--output-dir @OUT@ --only "kramp_A_B:1,kramp_A_B:2,kramp_A_B:3,kramp_A_to_B:1,kramp_A_to_B:2,kramp_A_to_B:3,kfrozen_A_B:1,kfrozen_A_B:2,kfrozen_A_B:3,kfrozen_A_to_B:1,kfrozen_A_to_B:2,kfrozen_A_to_B:3" --n-cores 4 --jobs 3)
