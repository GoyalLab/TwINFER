# derived 2026-09-30 from run_8scenario_zscores.sh | SBATCH of the original: --array=0-1 --cpus-per-task=24 --mem=64GB --time=3:00:00 --job-name=8scen_zscores
# 8 scenarios x {20 reps baseline/multistate, 3 reps drift_lowmid} at two (t1,t2) settings: task 0 -> t1=10,t2=20 ; task 1 -> t1=1,t2=20.
MODE=array
SCRIPT=run_6scenario_zscores.py
BASE="${TWINFER_PROJECT_ROOT}/analysis_data/drift_inference/eight_scenario"
TASK_EXPORTS=("DRIFT_T1=10 DRIFT_T2=20" "DRIFT_T1=1 DRIFT_T2=20")
TASK_OUT=("$BASE/t1_10_t2_20" "$BASE/t1_1_t2_20")
MKDIRS=("$BASE/logs" "@OUT@")
ARGS=(--output-dir @OUT@ --n-cores 4 --jobs 6)
